@model Project
@{ ViewData["Title"] = "Видалення проєкту"; }
<h1 class="h3">Видалити проєкт?</h1>
<div class="alert alert-danger">
    Проєкт «@Model.Name» і всі його завдання (@Model.Tasks.Count) буде видалено безповоротно.
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button class="btn btn-danger">Так, видалити</button>
    <a asp-action="Index" class="btn btn-link">Скасувати</a>
</form>
