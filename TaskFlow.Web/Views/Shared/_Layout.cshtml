
@inject IConfiguration Configuration
@{ var gaId = Configuration["Analytics:GoogleMeasurementId"]; }

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskFlow</title>

    @if (!IsSectionDefined("Head"))
    {
        <meta name="description" content="TaskFlow — простий трекер проєктів і завдань." />
    }

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @if (!string.IsNullOrWhiteSpace(gaId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@gaId');
        </script>
    }

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Projects" asp-action="Index">TaskFlow</a>
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Projects" asp-action="Index">Проєкти</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Tasks" asp-action="Index">Завдання</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Користувачі</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Labels" asp-action="Index">Мітки</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Stats" asp-action="Index">Статистика</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Game" asp-action="Index">Гра</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Editor" asp-action="Index">Редактор</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Live" asp-action="Index">Живі події</a></li>
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><span class="navbar-text me-3">@User.Identity.Name</span></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-link nav-link">Вийти</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Увійти через Google</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">@RenderBody()</main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/project-select.js" asp-append-version="true"></script>
    <script src="~/js/analytics.js" asp-append-version="true"></script>
    <script src="~/js/file-preview.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
