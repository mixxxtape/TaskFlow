@model TaskItem
@{
    ViewData["Title"] = Model.Title;
    var imageExt = new[] { ".png", ".jpg", ".jpeg", ".gif" };
    var isImage = Model.AttachmentUrl != null
        && imageExt.Contains(System.IO.Path.GetExtension(Model.AttachmentUrl).ToLowerInvariant());
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h3 m-0">@Model.Title</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Редагувати</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Видалити</a>
    </div>
</div>
<dl class="row">
    <dt class="col-sm-3">Проєкт</dt>
    <dd class="col-sm-9"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">@Model.Project?.Name</a></dd>
    <dt class="col-sm-3">Статус</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Status)</dd>
    <dt class="col-sm-3">Пріоритет</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Priority)</dd>
    <dt class="col-sm-3">Виконавець</dt><dd class="col-sm-9">@(Model.Assignee?.Name ?? "—")</dd>
    <dt class="col-sm-3">Термін</dt><dd class="col-sm-9">@(Model.DueDate?.ToString("dd.MM.yyyy") ?? "—")</dd>
    <dt class="col-sm-3">Мітки</dt>
    <dd class="col-sm-9">
        @foreach (var l in Model.Labels) { <span class="badge" style="background-color:@l.Color">@l.Name</span> }
        @if (!Model.Labels.Any()) { <span>—</span> }
    </dd>
    <dt class="col-sm-3">Опис</dt><dd class="col-sm-9" style="white-space:pre-wrap">@Model.Description</dd>
    <dt class="col-sm-3">Вкладення</dt>
    <dd class="col-sm-9">
        @if (Model.AttachmentUrl is null) { <span>—</span> }
        else
        {
            <a href="@Model.AttachmentUrl" target="_blank">Відкрити файл</a>
            @if (isImage) { <div class="mt-2"><img src="@Model.AttachmentUrl" alt="Вкладення" class="img-thumbnail" style="max-height:240px" /></div> }
        }
    </dd>
</dl>

<h2 class="h5 mt-4">Коментарі (@Model.Comments.Count)</h2>
@foreach (var c in Model.Comments.OrderBy(c => c.CreatedAt))
{
    <div class="border rounded p-2 mb-2 d-flex justify-content-between">
        <div>
            <strong>@c.Author?.Name</strong>
            <small class="text-muted">@c.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
            <div style="white-space:pre-wrap">@c.Text</div>
        </div>
        <form asp-controller="Comments" asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@c.Id" />
            <button class="btn btn-sm btn-outline-danger">×</button>
        </form>
    </div>
}
<form asp-controller="Comments" asp-action="Create" method="post" class="mt-3">
    <input type="hidden" name="taskItemId" value="@Model.Id" />
    <div class="row g-2">
        <div class="col-md-3">
            <select name="authorId" class="form-select" required asp-items="(SelectList)ViewBag.Users">
                <option value="">Автор…</option>
            </select>
        </div>
        <div class="col"><input name="text" class="form-control" placeholder="Коментар" required maxlength="2000" /></div>
        <div class="col-auto"><button class="btn btn-primary">Додати</button></div>
    </div>
</form>
<a asp-action="Index" class="d-inline-block mt-3">← До списку</a>
