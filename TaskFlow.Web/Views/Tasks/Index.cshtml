@model List<TaskItem>
@{ ViewData["Title"] = "Завдання"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Завдання</h1>
    <a asp-action="Create" class="btn btn-primary">Нове завдання</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="projectId" class="form-select" asp-items="(SelectList)ViewBag.Projects">
            <option value="">Усі проєкти</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<ItemStatus>()">
            <option value="">Усі статуси</option>
        </select>
    </div>
    <div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Пошук за назвою" /></div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Фільтрувати</button></div>
</form>
@if (!Model.Any())
{
    <p class="text-muted">Завдань не знайдено.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead><tr><th>Назва</th><th>Проєкт</th><th>Статус</th><th>Пріоритет</th><th>Виконавець</th><th>Мітки</th><th></th></tr></thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@t.Id">@t.Title</a>@(t.AttachmentUrl != null ? " 📎" : "")</td>
                <td>@t.Project?.Name</td>
                <td>@Html.DisplayFor(_ => t.Status)</td>
                <td>@Html.DisplayFor(_ => t.Priority)</td>
                <td>@(t.Assignee?.Name ?? "—")</td>
                <td>
                    @foreach (var l in t.Labels)
                    {
                        <span class="badge" style="background-color:@l.Color">@l.Name</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Редагувати</a>
                    <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
